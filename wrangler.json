{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paymerchmob",
  "compatibility_date": "2026-10-02",
  "main": "src/mock-worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "static-dist",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_LEDGER",
        "class_name": "DemoLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["DemoLedger"]
    }
  ],
  "observability": {
    "enabled": true
  }
}