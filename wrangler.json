{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paymerchmob",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}